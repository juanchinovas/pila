{
  "name": "Pila Dev",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:20-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "onCreateCommand": "npm install && cd demo-vue && rm -rf node_modules package-lock.json && npm install",
  "postCreateCommand": "npx playwright install --with-deps chromium",
  "forwardPorts": [5173, 5174],
  "portsAttributes": {
    "5173": {
      "label": "Vite Dev Server (Vanilla)"
    },
    "5174": {
      "label": "Vite Dev Server (Vue)"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "bradlc.vscode-tailwindcss",
        "Vue.volar"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode"
      }
    }
  }
}
