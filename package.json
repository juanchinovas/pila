{
  "name": "@sunacchi/pila",
  "version": "1.2.0",
  "description": "Pluggable Inline Layout Authoring — a framework-agnostic Notion-style block editor",
  "type": "module",
  "main": "./dist/pila.umd.cjs",
  "module": "./dist/pila.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/pila.js",
      "require": "./dist/pila.umd.cjs",
      "types": "./dist/index.d.ts"
    },
    "./styles": {
      "import": "./dist/pila.css",
      "types": "./dist/styles.d.ts"
    },
    "./styles/source": "./src/styles/pila.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "./dist/pila.css",
    "./src/styles/pila.css",
    "./src/styles/variables.css",
    "./src/blocks/ParagraphBlock.ts",
    "./src/blocks/HeadingBlock.ts",
    "./src/blocks/ListBlock.ts",
    "./src/blocks/TodoBlock.ts",
    "./src/blocks/CodeBlock.ts",
    "./src/blocks/QuoteBlock.ts",
    "./src/blocks/CalloutBlock.ts",
    "./src/blocks/DividerBlock.ts",
    "./src/blocks/ImageBlock.ts",
    "./src/blocks/TableBlock.ts",
    "./src/blocks/ColumnsBlock.ts",
    "./src/blocks/ButtonBlock.ts"
  ],
  "scripts": {
    "dev": "vite",
    "dev:vue": "cd demo-vue && npm run dev",
    "build": "tsc --noEmit && vite build && cp src/styles.d.ts dist/styles.d.ts",
    "preview": "vite preview",
    "preview:vue": "cd demo-vue && npm run preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:cross": "playwright test --config=playwright.cross.config.ts",
    "verify": "npm run lint && npm run test && npm run test:e2e"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.59.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^25.6.0",
    "@types/prismjs": "^1.26.6",
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "@typescript-eslint/parser": "^8.59.2",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vitest/coverage-v8": "^1.6.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^10.3.0",
    "eslint-plugin-vue": "^10.9.1",
    "gifenc": "^1.0.3",
    "jsdom": "^24.1.0",
    "pngjs": "^7.0.0",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.3",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.59.2",
    "vite": "^5.2.11",
    "vite-plugin-dts": "^3.9.1",
    "vitest": "^1.6.0",
    "vue": "^3.5.33"
  },
  "keywords": [
    "block-editor",
    "notion",
    "editor",
    "typescript",
    "no-framework"
  ],
  "license": "MIT",
  "author": "juanchinovas",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/juanchinovas/pila.git"
  },
  "homepage": "https://github.com/juanchinovas/pila#readme",
  "bugs": {
    "url": "https://github.com/juanchinovas/pila/issues"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "lit": "^3.3.2",
    "prismjs": "^1.30.0"
  }
}
